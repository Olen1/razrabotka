[MASTER]
init-hook='import sys; sys.path.append(".")'
ignore-paths=^.*\/(venv|__pycache__|\.git|\.pytest_cache|build|dist|\.tox).*$

[MESSAGES CONTROL]
disable=
    missing-docstring,
    invalid-name,
    too-few-public-methods,
    too-many-arguments,
    too-many-locals,
    too-many-statements,
    duplicate-code,
    import-error,
    missing-final-newline,
    trailing-newlines,
    trailing-whitespace,
    wrong-import-position,
    unused-import,
    unused-argument,
    redefined-outer-name,
    unnecessary-lambda,
    unused-variable,
    raise-missing-from,
    bad-indentation,
    line-too-long

[FORMAT]
max-line-length=120

[BASIC]
extension-pkg-whitelist=

[TYPECHECK]
generated-members=
    sqlalchemy.orm.Mapped,
    sqlalchemy.Column,
    sqlalchemy.orm.relationship,
    id,
    created_at,
    updated_at